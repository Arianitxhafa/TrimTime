{
  "expo": {
    "name": "TrimTime",
    "slug": "trimtime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trimtime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.arianitxhafa.trimtime",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arianitxhafa.trimtime",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrimTime përdor vendndodhjen për të të treguar berberët pranë teje."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrimTime përdor fotot për lokalin, portofolin e qethjeve dhe stilin që dëshiron.",
          "cameraPermission": "TrimTime përdor kamerën për të fotografuar qethjet dhe stilin që dëshiron.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "TrimTime përdor kamerën për të fotografuar qethjet dhe për të skanuar kodet QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TrimTime përdor Face ID për të hapur aplikacionin në mënyrë të sigurt."
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "TrimTime shton terminet e tua në kalendar, me kujtesë para orës."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "97f78475-6138-4b23-835b-d14490a2f242"
      }
    },
    "owner": "arianitts-team"
  }
}
