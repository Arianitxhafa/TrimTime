{
  "expo": {
    "name": "TrimTime",
    "slug": "trimtime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trimtime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.arianitxhafa.trimtime"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arianitxhafa.trimtime"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrimTime përdor vendndodhjen për të të treguar berberët pranë teje."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrimTime përdor fotot për lokalin, portofolin e qethjeve dhe stilin që dëshiron.",
          "cameraPermission": "TrimTime përdor kamerën për të fotografuar qethjet dhe stilin që dëshiron.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "TrimTime përdor kamerën për të fotografuar qethjet dhe për të skanuar kodet QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TrimTime përdor Face ID për të hapur aplikacionin në mënyrë të sigurt."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
