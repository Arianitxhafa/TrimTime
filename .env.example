# Kopjoje këtë skedar si .env dhe plotëso vlerat nga Supabase → Project Settings → API Keys.
# Vendos VETËM publishable/anon key. Mos vendos kurrë secret/service_role key në aplikacion.
EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Asistenti AI (Claude). Lëre "jo" që të mos kushtojë asgjë: kërkesat kuptohen falas në telefon.
# Për ta aktivizuar: vendos Edge Function-in "asistenti", shto ANTHROPIC_API_KEY te Supabase Secrets dhe këtu "po".
EXPO_PUBLIC_ASISTENTI_AI=jo
